# Fim de linha padronizado: LF no repositório e no checkout, em qualquer sistema.
# Evita diffs falsos entre Windows (CRLF) e Linux/macOS (LF).
* text=auto eol=lf

# Scripts do Windows precisam de CRLF para rodar no cmd/PowerShell.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Arquivos binários: o Git não mexe no fim de linha nem tenta mostrar diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.jar  binary
