
#esta pasta foi  criado para ser um exemplo da .env
# Copie este arquivo para ".env" e ajuste os valores.
   # O arquivo .env NÃO deve ser versionado.

   POSTGRES_DB=connect_crm
   POSTGRES_USER=connectcrm
   POSTGRES_PASSWORD=defina_sua_senha
   # Use 5433 se já tiver um PostgreSQL instalado no Windows
   POSTGRES_PORT=5432

   # Chave que assina o token de login (JWT). Use pelo menos 32 caracteres.
   # Cada um gera a sua; em produção, use uma chave longa e aleatória.
   JWT_SECRET=troque_por_uma_chave_com_pelo_menos_32_caracteres
